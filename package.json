{
  "name": "dpp-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Yometel desktop apps (Windows/Mac): the DPP web app (main.js) and the DPP Manager admin site (admin-main.js), each wrapped in Electron. The main process connects directly to the Impinj R700 reader over LLRP/TCP (same llrpjs the app's native mobile build and the backend use), bypassing the backend and Tailscale entirely when this machine is on the reader's own local network.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:admin": "electron admin-main.js",
    "dist:win": "electron-builder --win --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "dist:admin:win": "electron-builder --win --config electron-builder.admin.json --publish=never",
    "dist:admin:mac": "electron-builder --mac --config electron-builder.admin.json --publish=never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "llrpjs": "^1.0.1"
  },
  "build": {
    "appId": "com.yometel.dpp.desktop",
    "productName": "Yometel DPP",
    "publish": null,
    "files": [
      "main.js",
      "shell.js",
      "preload.js",
      "impinjLlrpMain.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "build/icon.png"
    }
  }
}
